<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="0dp"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true" >

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
        app:title="Donor Darah"
        app:titleCentered="false"
        app:titleTextColor="@color/toolbarText" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Input Nama -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nama Lengkap">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtNama"
                    android:textColor="@color/text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Input Umur -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Umur">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtUmur"
                    android:inputType="number"
                    android:textColor="@color/text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Input Berat -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Berat Badan (kg)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtBerat"
                    android:inputType="number"
                    android:textColor="@color/text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Input Gol Darah -->
            <TextView
                android:layout_marginTop="8dp"
                android:text="Golongan Darah:"
                android:textColor="@color/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Spinner Golongan Darah -->
            <Spinner
                android:id="@+id/spinnerGolongan"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <!-- Input Riwayat -->
            <CheckBox
                android:id="@+id/cbPenyakit"
                android:layout_marginTop="8dp"
                android:text="Memiliki riwayat penyakit (tekanan darah tinggi, diabetes, dll)"
                android:textColor="@color/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Tombol Cek -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCek"
                android:text="Cek Kelayakan Donor"
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorPrimary"
                app:backgroundTint="?attr/colorPrimary"
                app:iconTint="@color/text"
                android:textColor="@color/textWhite" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
