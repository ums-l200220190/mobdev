<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true" >

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarHasil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
        app:navigationIcon="@drawable/ic_baseline_arrow_back_24"
        app:title="Hasil Kelayakan"
        app:titleCentered="false"
        app:titleTextColor="@color/toolbarText" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:layout_marginBottom="64dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Nama -->
        <TextView
            android:id="@+id/txtNama"
            android:text="Halo, Nama!"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="center"
            android:textColor="@color/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Status -->
        <TextView
            android:id="@+id/txtStatus"
            android:text="Status"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:padding="16dp"
            android:background="@drawable/bg_status_default"
            android:layout_marginTop="16dp"
            android:textColor="@color/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Alasan -->
        <TextView
            android:id="@+id/txtAlasan"
            android:text="Alasan:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:background="@drawable/bg_alasan_default"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:textAlignment="viewStart" />

        <!-- Tombol Maps -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMaps"
            android:text="Lihat Lokasi PMI"
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorPrimary"
            app:backgroundTint="?attr/colorSecondary"
            app:iconTint="@color/textBlack"
            android:textColor="@color/text" />

    </LinearLayout>

</LinearLayout>
