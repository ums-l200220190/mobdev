<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.DonorDarah" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Colors untuk dark mode -->
        <item name="colorPrimary">@color/colorPrimary</item> <!-- #1F1F1F -->
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item> <!-- #2C2C2C -->
        <item name="colorSecondary">@color/colorSecondary</item> <!-- tetap teal -->

        <!-- Background -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimary</item>
        <item name="android:windowLightStatusBar">false</item> <!-- status bar icon putih -->

        <!-- Toolbar text -->
        <item name="android:textColorPrimary">@color/text</item>
    </style>
</resources>
